BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN
COBALT_URL=https://YOUR-COBALT-INSTANCE.up.railway.app
# Optional, only if your Cobalt instance requires authentication:
COBALT_AUTH=
# Optional: comma-separated Telegram numeric user IDs. Empty means public bot.
ALLOWED_USERS=
# Keep below Telegram cloud Bot API upload limit (bytes). Default is 48 MiB.
MAX_UPLOAD_BYTES=50331648
